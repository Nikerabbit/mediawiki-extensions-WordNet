{
	"name": "mediawiki/wordnet",
	"type": "mediawiki-extension",
	"require": {
		"php": ">=8.3",
		"composer/installers": "^1.0.1 || ^2.0",
		"parsecsv/php-parsecsv": "^1.3.2"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "v52.0.1",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "v1.0.0",
		"php-parallel-lint/php-parallel-lint": "v1.4.0",
		"rector/rector": "2.6.7",
		"mediawiki/mediawiki-phan-config": "0.20.0"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"minus-x check .",
			"parallel-lint . --exclude vendor --exclude node_modules",
			"phpcs -p -s"
		],
		"rector": "rector",
		"phan": "phan -d . --long-progress-bar"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3.0"
		}
	},
	"description": "WordNet import and display tools",
	"license": "GPL-2.0-or-later"
}
